# Defaults are local-only. Keep API on loopback; the development runner has no multi-tenant boundary.
SAMYAK_API_URL=http://127.0.0.1:8000
SAMYAK_DATA=./var
SAMYAK_MODELS=./data/models
SAMYAK_RUNNER_IMAGE=samyak-runner:phase1
# Optional: source, witnessed inputs, tests and short train-only precedents are sent to this endpoint.
# Leave all three empty for fully local deterministic repairs.
SAMYAK_LLM_BASE_URL=
SAMYAK_LLM_MODEL=
SAMYAK_LLM_API_KEY=
# Measured worker optimization: at most two independent candidate suites, each with unchanged container limits.
# Set 1 for sequential validation on constrained Docker hosts. Other values fall back to 1.
SAMYAK_CANDIDATE_CONCURRENCY=2
